# SerpApi — https://serpapi.com/manage-api-key
# The key currently configured in this environment is REJECTED by SerpApi ("Invalid API key").
SERPAPI_API_KEY=

# Supabase. Do NOT point this at an unrelated project; use a dedicated one.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Subject identity used to build the query set.
SUBJECT_NAME=Fredrick Mendez
SUBJECT_LOCALES=Florida,Boca Raton,Denver

# Local response cache TTL (seconds). Keeps repeat scans off the paid API.
CACHE_TTL_SECONDS=21600

# Max SerpApi requests per minute.
RATE_LIMIT_RPM=20
