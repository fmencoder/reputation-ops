# SerpApi — https://serpapi.com/manage-api-key
# The key currently configured in this environment is REJECTED by SerpApi ("Invalid API key").
SERPAPI_API_KEY=

# Supabase. Do NOT point this at an unrelated project; use a dedicated one.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Subject identity used to build the query set.
SUBJECT_NAME=Fredrick Mendez
SUBJECT_LOCALES=Florida,Boca Raton,Denver

# Local response cache TTL (seconds). Keeps repeat scans off the paid API.
CACHE_TTL_SECONDS=21600

# Max SerpApi requests per minute.
RATE_LIMIT_RPM=20

# --- Contact inquiry form (server-side only; never NEXT_PUBLIC_) ---
# Required for the /contact/ form to deliver. Without both, the route returns
# 502 and the form shows its error state with the mailto: fallback intact.
# Set these on the Vercel project, not in the repository.
#
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# The From: address. Must be on a domain verified with Resend, which requires
# SPF/DKIM records. novraintelligence.com currently publishes none.
CONTACT_FROM_EMAIL=
# Optional. Overrides the destination inbox, which defaults to the
# contact@novraintelligence.com constant in frontend/lib/site.ts.
# Needed today because novraintelligence.com publishes no MX record and so
# cannot receive mail yet. Server-side only; never read from a request.
CONTACT_INBOX=
